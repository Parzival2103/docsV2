            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"WhatsApp Sucursal 2\",\n  \"externalRef\": \"opcional-idempotente\",\n  \"purpose\": \"production\"\n}"
            },
            "description": "Client Bearer with instancias.crear. Requires Idempotency-Key. Quota: demo/starter=1, business=3, empresa=unlimited. Full quota → 422 upgrade message. Replay by externalRef → 200, no extra quota."
          },
          "response": [
            {
              "name": "202 provisioning",
              "code": 202,
              "header": [
                {
                  "key": "content-type",
                  "value": "application/json"
                }
              ],
              "body": "{\"publicId\":\"01JXXXXXXXXXXXXXXXXXXXXXX\",\"status\":\"provisioning\",\"label\":\"WhatsApp Sucursal 2\"}"
            },
            {
              "name": "422 quota full",
              "code": 422,
              "header": [
                {
                  "key": "content-type",
                  "value": "application/json"
                }
              ],
              "body": "{\"message\":\"Has alcanzado el límite de instancias WhatsApp de tu plan. Mejora tu cuenta para generar otra instancia.\"}"
            }
          ]
        },
